# VERA20k configuration — copy to config.toml and adjust paths.
# config.toml is gitignored because it contains machine-specific paths.

[paths]
# Point this to your Red Alert 2: Yuri's Revenge installation directory.
# The engine reads .mix files directly from here (ra2.mix, language.mix, etc.)
ra2_dir = "C:/Westwood/RA2"
# Optional VERA.INI location (defaults to VERA20k's user data folder).
# Relative paths are resolved beside this config file, outside the game folder.
# settings_dir = "."

[ini]
# Root-file selection only, not full MOD gameplay or a different MIX mount policy.
# Default yr preserves the normal Yuri's Revenge path. mo requires all three MO
# roots; auto accepts exactly one complete set with no partial alternate set.
profile = "yr" # yr | mo | auto | custom
# With profile = "custom", specify all three logical INI basenames:
# rules = "my-rules.ini"
# art = "my-art.ini"
# ai = "my-ai.ini"

[graphics]
extra_animations = true   # cosmetic effects: water/ore sparkles (future: laser pulses, particle trails)
# Full screen, zoom and the original 4:3 shape are on the Options page (saved in VERA.INI).

[gameplay]
input_delay_ticks = 15
pause_on_focus_loss = false   # true freezes a running match (sim and message clock) while the window is in the background, like the original game. A deactivated window silences audio either way.

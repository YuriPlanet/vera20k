# No trailing slash: a linked worktree reaches the retail INIs through an
# `ini` symlink, which a directory-only pattern does not match.
/ini

/infodocs/

/docs/*
!/docs/ares-generic-warhead.md
!/docs/ini-roots.md
!/docs/_config.yml
!/docs/index.md
!/docs/Networking.md
!/docs/ares-unit-delivery.md
!/docs/ares-superweapon-building-gates.md
!/docs/ares-superweapon-money.md
!/docs/ini-directives.md
!/docs/script-action-56.md

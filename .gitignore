.mcp.json
# Cloudflare CLI cache: holds the account ID and email wherever `cf` runs.
.cloudflare/
# Private keys, such as the update signing key (.github/release/downloads.md).
*.pem
/.claude/*
!/.claude/skills/
/.claude/skills/ghidra-up/
/.agents/*
!/.agents/skills/
/.agents/skills/ghidra-up/
/todo/
/logs/
/saves/
/replays/

tools/vendor-eval/

/*.md
!/README.md
!/README.sv.md
!/README.de.md
!/README.zh-CN.md
!/README.ar.md
!/README.es.md
!/README.ja.md
!/README.ru.md
!/README.th.md
!/README.tr.md
!/README.vi.md
!/LEGAL.md
# Kept visible: a root CLAUDE.md would stop Claude Code reading AGENTS.md.
!/CLAUDE.md
!/AGENTS.md

/*.js
/*.py

# throwaway verification build dir (parallel-session exe lock workaround)
/target-verify/

# Scratch area for deletes and one-off scripts; never a deliverable.
/_trash/

# Dashboard build dependencies; compiled JS is intentionally tracked.
/tools/telemetry-dashboard/node_modules/

# --- Android (android/) ---
# Gradle output, the machine-local SDK path, the generated debug keystore, and
# the native libraries cargo-ndk writes into the APK's jniLibs directory: all
# generated, none committed.
/android/.gradle/
/android/.kotlin/
/android/.android/
/android/local.properties
/android/**/build/
/android/app/src/main/jniLibs/
!/docs/phobos-roof-production-anim.md

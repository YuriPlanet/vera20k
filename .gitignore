!/docs/de/
!/docs/ru/
!/docs/sv/
!/docs/th/
!/docs/tr/
!/docs/zh-CN/
!/docs/images/
!/docs/images/**

.mcp.json
/.claude/*
!/.claude/skills/
/.claude/skills/ghidra-up/
/.agents/*
!/.agents/skills/
/.agents/skills/ghidra-up/
/todo/
/logs/
/saves/
/replays/

tools/vendor-eval/

/*.md
!/README.md
!/README.sv.md
!/README.de.md
!/README.zh-CN.md
!/README.ar.md
!/README.ru.md
!/README.th.md
!/README.tr.md
# Kept visible: a root CLAUDE.md would stop Claude Code reading AGENTS.md.
!/CLAUDE.md
!/AGENTS.md

/*.js
/*.py

# throwaway verification build dir (parallel-session exe lock workaround)
/target-verify/

# Dashboard build dependencies; compiled JS is intentionally tracked.
/tools/telemetry-dashboard/node_modules/

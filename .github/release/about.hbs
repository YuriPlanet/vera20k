    <h2>Overview</h2>
    <ul>
        {{#each overview}}
        <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
        {{/each}}
    </ul>

    <h2>License texts</h2>
    {{#each licenses}}
        {{#if first_of_kind}}<h3 id="{{id}}">{{name}}</h3>{{/if}}
        <p>Used by:</p>
        <ul class="used-by">
            {{#each used_by}}
            <li>{{crate.name}} {{crate.version}}</li>
            {{/each}}
        </ul>
        <pre class="license-text">{{text}}</pre>

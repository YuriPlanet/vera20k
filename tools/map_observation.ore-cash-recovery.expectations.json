{
  "schema_version": "vera20k.map-observation-expectations.v1",
  "assertions": [
    {
      "name": "Empty harvester at scenario start",
      "subject": {
        "actor": {
          "type_id": "HARV",
          "owner": "VERA-OBSERVER"
        }
      },
      "at_step": 0,
      "field": "miner.cargo_bales",
      "op": "eq",
      "value": 0
    },
    {
      "name": "Harvest fills the stock forty-bale cargo",
      "subject": {
        "actor": {
          "type_id": "HARV",
          "owner": "VERA-OBSERVER"
        }
      },
      "eventually": {
        "from_step": 1,
        "through_step": 1400
      },
      "field": "miner.cargo_bales",
      "op": "eq",
      "value": 40
    },
    {
      "name": "No cash while the paid build waits for ore",
      "subject": {
        "house": "VERA-OBSERVER"
      },
      "always": {
        "from_step": 100,
        "through_step": 1300
      },
      "field": "economy.credits",
      "op": "eq",
      "value": 0
    },
    {
      "name": "Only initial cash was spent before unloading",
      "subject": {
        "house": "VERA-OBSERVER"
      },
      "always": {
        "from_step": 100,
        "through_step": 1300
      },
      "field": "economy.spent_credits",
      "op": "eq",
      "value": 50
    },
    {
      "name": "No ore score before unloading",
      "subject": {
        "house": "VERA-OBSERVER"
      },
      "always": {
        "from_step": 100,
        "through_step": 1300
      },
      "field": "economy.score",
      "op": "eq",
      "value": 0
    },
    {
      "name": "Original paid head remains in limbo during cash stall",
      "subject": {
        "actor": {
          "type_id": "E2",
          "owner": "VERA-OBSERVER",
          "bind_step": 5
        }
      },
      "always": {
        "from_step": 100,
        "through_step": 1300
      },
      "field": "in_limbo",
      "op": "eq",
      "value": true
    },
    {
      "name": "Ore unload reaches the existing score owner",
      "subject": {
        "house": "VERA-OBSERVER"
      },
      "eventually": {
        "from_step": 1400,
        "through_step": 1450
      },
      "field": "economy.score",
      "op": "eq",
      "value": 200
    },
    {
      "name": "Original paid head leaves after income without Resume",
      "subject": {
        "actor": {
          "type_id": "E2",
          "owner": "VERA-OBSERVER",
          "bind_step": 5
        }
      },
      "eventually": {
        "from_step": 1430,
        "through_step": 1500
      },
      "field": "in_limbo",
      "op": "eq",
      "value": false
    },
    {
      "name": "Harvester releases its dock contact",
      "subject": {
        "actor": {
          "type_id": "HARV",
          "owner": "VERA-OBSERVER"
        }
      },
      "eventually": {
        "from_step": 1430,
        "through_step": 1500
      },
      "field": "radio.contacts",
      "op": "eq",
      "value": [
        null
      ]
    },
    {
      "name": "Harvester collects ore again",
      "subject": {
        "actor": {
          "type_id": "HARV",
          "owner": "VERA-OBSERVER"
        }
      },
      "at_step": 2000,
      "field": "miner.cargo_bales",
      "op": "gt",
      "value": 0
    },
    {
      "name": "Two conscripts paid in full",
      "subject": {
        "house": "VERA-OBSERVER"
      },
      "at_step": 2000,
      "field": "economy.spent_credits",
      "op": "eq",
      "value": 200
    },
    {
      "name": "Final cash reflects ore and both paid units",
      "subject": {
        "house": "VERA-OBSERVER"
      },
      "at_step": 2000,
      "field": "economy.credits",
      "op": "eq",
      "value": 850
    },
    {
      "name": "Only one ore load scored",
      "subject": {
        "house": "VERA-OBSERVER"
      },
      "at_step": 2000,
      "field": "economy.score",
      "op": "eq",
      "value": 200
    }
  ]
}

      }
    },
    {
      "name": "outside factory admits deployment",
      "subject": {
        "actor": {
          "owner": "VERA-OBSERVER",
          "type_id": "AMCV",
          "bind_step": 7380
        }
      },
      "at_step": 8401,
      "field": "mission.queued",
      "op": "eq",
      "value": 16
    },
    {
      "name": "converted yard owns new site",
      "subject": {
        "actor": {
          "owner": "VERA-OBSERVER",
          "type_id": "GACNST",
          "cell": [40, 96],
          "bind_step": 8450
        }
      },
      "at_step": 8700,
      "field": "cell",

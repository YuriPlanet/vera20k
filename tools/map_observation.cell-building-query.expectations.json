      "at_step": 7380,
      "field": "cell",
      "op": "eq",
      "value": [29, 92]
    },
    {
      "name": "factory gate keeps moving",
      "subject": {
        "actor": {
          "owner": "VERA-OBSERVER",
          "type_id": "AMCV",
          "bind_step": 7380
        }
      },
      "at_step": 7381,
      "field": "mission.current",
      "op": "eq",
      "value": 2
    },
    {
      "name": "factory gate does not queue deploy",
      "subject": {
        "actor": {
          "owner": "VERA-OBSERVER",
          "type_id": "AMCV",
          "bind_step": 7380
        }
      },
      "at_step": 7381,
      "field": "mission.queued",
      "op": "eq",
      "value": -1
    },
    {

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws its own splash window before the app's first frame,
         and it ignores `windowBackground` for it: the art has to be named as the
         splash icon, over the same colour, with no icon animation. -->
    <style name="Theme.Vera20k" parent="android:Theme.Black.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The lobby and LAN discovery are HTTPS/UDP; ACCESS_WIFI_STATE is for the
         WifiManager locks multicast discovery needs (P8). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Vulkan is the shipping renderer baseline, so a device without it cannot
         run the game. GLES-only devices are not supported yet (P4 decision). -->
    <uses-feature
        android:name="android.hardware.vulkan.level"
        android:version="0"
        android:required="true" />
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="false" />

    <application
        android:label="VERA20K"
        android:icon="@mipmap/ic_launcher_retail"
        android:roundIcon="@mipmap/ic_launcher_retail"
        android:hasCode="true"
        android:largeHeap="true"
        android:extractNativeLibs="false"
        android:allowBackup="false"
        android:theme="@style/Theme.Vera20k">

        <!-- NativeActivity loads android.app.lib_name and calls android_main in
             libvera20k_android.so (android/src/lib.rs). configChanges lists
             everything winit handles, so a rotation or split-screen resize
             reaches Rust as a resize instead of destroying the activity. -->
        <activity
            android:name="org.vera20k.VeraActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|fontScale|locale|layoutDirection">

            <!-- The .so base name, without lib/ and .so: the crate's output is
                 libvera20k_android.so. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="vera20k_android" />
        </activity>

        <!-- Two launcher entries, one enabled at a time. A launcher icon is a
             resource compiled into the package, so the VERA Icon box cannot
             change it directly: `VeraActivity.applyAppIcon` enables the chosen
             alias and disables the other through PackageManager. The activity
             itself carries no LAUNCHER filter, or the app would show twice.

             NativeActivity reads `android.app.lib_name` from the component it
             was launched through, and an alias does not inherit the target's
             meta-data: without this copy on each alias the process dies in
             NativeActivity.onCreate looking for the default `libmain.so`. -->
        <activity-alias
            android:name="org.vera20k.LauncherRetail"
            android:targetActivity="org.vera20k.VeraActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher_retail"
            android:roundIcon="@mipmap/ic_launcher_retail"
            android:theme="@style/Theme.Vera20k.RetailSplash"
            android:label="VERA20K">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.lib_name"
                android:value="vera20k_android" />
        </activity-alias>

        <activity-alias
            android:name="org.vera20k.LauncherVera"
            android:targetActivity="org.vera20k.VeraActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_vera"
            android:roundIcon="@mipmap/ic_launcher_vera"
            android:theme="@style/Theme.Vera20k.VeraSplash"
            android:label="VERA20K">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.lib_name"
                android:value="vera20k_android" />
        </activity-alias>
    </application>

</manifest>
